{
  "name": "@suxeca/dsh-typesafe",
  "version": "0.1.0",
  "description": "TypeSafe System One (Jev) 语义判断服务：把 Jev 封装为 DSH 总线上的 ctx.typesafe 单例服务 + typesafe_eval 工具 + 设置页密钥/状态区块（密钥零明文、离线可测）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "link:deps": "node scripts/link-checkout-deps.mjs",
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "build:client": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
