# /lib and /node_modules per package
lib/
node_modules/

# pnpm
.pnpm-store/

# misc
*.log
.DS_Store

# 运行时数据：文件快照/撤销存储（非源码）
.dsh-undo/

# 🔒 私人材料：含真实网络拓扑或仅供本机使用的补丁，永不入库
packages/dsh-secure-context-polyfill/

# 本机正在使用的 better-sidebar 修订快照；只在 README 记录官方上游，
# 不把不可从上游获取的本地 root commit 误登记为损坏的 submodule。
third-party/dsh-better-sidebar/

# 个人交接笔记（已移出仓库至 ~/.dsh/notes/，防止误提交）
PLUGIN-HANDOFF.md

# 本地打包产物（发布时由 CI prepublishOnly 重新生成）
*.tgz

# 运行时产物：agents team 会话状态 / vision-toolkit 制品（非源码）
.agent-teams/
.dsh-vision-toolkit/

# memsearch 记忆：memory/ 是原始对话沉淀（含本机路径与项目细节，同 sage-mem
# 的 .claude-mem.db 一样不该进仓库）；索引状态与 Milvus 影子数据同理。
# skill-candidates/ 官方设计为可 git 跟踪，故不在此列。
.memsearch/memory/
.memsearch/.index-state.json
.memsearch/.maintenance-state.json
.memsearch/*.db

# 本机会话导出与运维记录：含真实对话内容、主机与账号信息，永不入库
dsh-session-*.zip
vps_monitor_records.csv
test_vps_stability.sh
handoff-*.md
*.pptx

# 本机评估/审计记录（含真实会话内容与工作目录），仅留本机
*审计*.md

# 本机临时工作目录（会话检查/预设草稿）
.tmp_session_*/
.preset-work/
tmp_session_inspect/

# 本地部署副本：运行时用这一份，公开仓库的 packages/ 保持 pristine
local-deploy/

