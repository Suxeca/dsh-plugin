{
  "name": "dsh-gpt-compat",
  "description": "Fail-closed DSH compatibility guard for redundant GPT/Codex sandbox escalation arguments",
  "version": "0.2.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./escalation-guard": {
      "types": "./dist/escalation-guard.d.ts",
      "default": "./dist/escalation-guard.js"
    },
    "./sandbox-modes": {
      "types": "./dist/sandbox-modes.d.ts",
      "default": "./dist/sandbox-modes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "A3.png",
    "B3.png",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bash scripts/build.sh && node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "gpt",
    "codex",
    "sandbox",
    "escalation"
  ],
  "license": "MIT",
  "author": "YaoaY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaoaY/dsh-gpt-compat.git"
  },
  "homepage": "https://github.com/YaoaY/dsh-gpt-compat#readme",
  "bugs": {
    "url": "https://github.com/YaoaY/dsh-gpt-compat/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.28.2",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "publint": "^0.3.15",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
